---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ثبت تنخواه">
    <div class="container-portal">
        <!-- Page Header -->
        <section class="hero">
            <h1 class="hero-title">ثبت تنخواه</h1>
            <p class="hero-subtitle">
                از طریق فرم زیر می‌توانید درخواست تنخواه خود را ثبت کنید
            </p>
        </section>

        <!-- Form Section -->
        <section class="pb-12">
            <div class="form-card max-w-2xl mx-auto">
                <form id="payrollForm" class="space-y-6">
                    <div class="form-group">
                        <label for="fullName">نام و نام خانوادگی</label>
                        <input
                            type="text"
                            id="fullName"
                            name="fullName"
                            placeholder="نام کامل خود را وارد کنید"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="employeeId">کد پرسنلی</label>
                        <input
                            type="text"
                            id="employeeId"
                            name="employeeId"
                            placeholder="کد پرسنلی خود را وارد کنید"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="department">واحد / بخش</label>
                        <select id="department" name="department" required>
                            <option value="">انتخاب کنید</option>
                            <option value="مالی">مالی</option>
                            <option value="اداری">اداری</option>
                            <option value="فنی">فنی</option>
                            <option value="تولید">تولید</option>
                            <option value="فروش">فروش</option>
                            <option value="پشتیبانی">پشتیبانی</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="amount">مبلغ درخواستی (ریال)</label>
                        <input
                            type="number"
                            id="amount"
                            name="amount"
                            placeholder="مبلغ را به ریال وارد کنید"
                            min="0"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="reason">شرح درخواست</label>
                        <textarea
                            id="reason"
                            name="reason"
                            rows="4"
                            placeholder="توضیحات مربوط به درخواست تنخواه را وارد کنید"
                            required
                        ></textarea>
                    </div>

                    <div class="form-group">
                        <label for="date">تاریخ درخواست</label>
                        <input
                            type="date"
                            id="date"
                            name="date"
                            required
                        />
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="btn btn-lg btn-full">
                            ثبت درخواست
                        </button>
                    </div>
                </form>

                <!-- Success Message (hidden by default) -->
                <div id="successMessage" class="success-message hidden mt-6">
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>درخواست شما با موفقیت ثبت شد!</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Back Link -->
        <section class="text-center pb-8">
            <a href="/" class="text-primary hover:opacity-80 transition">
                بازگشت به صفحه اصلی
            </a>
        </section>
    </div>

    <script>
        document.getElementById('payrollForm')?.addEventListener('submit', function(e) {
            e.preventDefault();

            // Show success message
            const successMessage = document.getElementById('successMessage');
            if (successMessage) {
                successMessage.classList.remove('hidden');
            }

            // Reset form
            this.reset();

            // Hide success message after 5 seconds
            setTimeout(() => {
                if (successMessage) {
                    successMessage.classList.add('hidden');
                }
            }, 5000);
        });
    </script>
</Layout>
