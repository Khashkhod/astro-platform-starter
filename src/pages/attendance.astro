---
import Layout from '../layouts/Layout.astro';
---

<Layout title="حضور و غیاب">
    <div class="container-portal">
        <!-- Page Header -->
        <section class="hero">
            <h1 class="hero-title">سیستم حضور و غیاب</h1>
            <p class="hero-subtitle">
                ورود به نرم‌افزار مدیریت حضور و غیاب کارکنان
            </p>
        </section>

        <!-- Login Form Section -->
        <section class="pb-12">
            <div class="form-card max-w-md mx-auto">
                <div class="text-center mb-8">
                    <div class="w-20 h-20 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-text">ورود به سیستم</h2>
                    <p class="text-text-muted mt-2">لطفاً اطلاعات خود را وارد کنید</p>
                </div>

                <form id="attendanceForm" class="space-y-6">
                    <div class="form-group">
                        <label for="username">نام کاربری</label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            placeholder="نام کاربری خود را وارد کنید"
                            required
                        />
                    </div>

                    <div class="form-group">
                        <label for="password">رمز عبور</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="رمز عبور خود را وارد کنید"
                            required
                        />
                    </div>

                    <div class="flex items-center gap-2">
                        <input
                            type="checkbox"
                            id="remember"
                            name="remember"
                            class="w-4 h-4 rounded border-border"
                        />
                        <label for="remember" class="mb-0 text-sm text-text-muted cursor-pointer">
                            مرا به خاطر بسپار
                        </label>
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="btn btn-secondary btn-lg btn-full">
                            ورود
                        </button>
                    </div>
                </form>

                <!-- Info Message -->
                <div id="loginMessage" class="hidden mt-6"></div>

                <!-- Help Text -->
                <div class="mt-6 pt-6 border-t border-border text-center">
                    <p class="text-sm text-text-muted">
                        در صورت فراموشی رمز عبور با واحد IT تماس بگیرید
                    </p>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="pb-12">
            <h2 class="section-title">امکانات سیستم</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white rounded-xl shadow-md p-6 text-center">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                        </svg>
                    </div>
                    <h3 class="font-bold text-text mb-2">ثبت ورود و خروج</h3>
                    <p class="text-sm text-text-muted">ثبت خودکار زمان ورود و خروج کارکنان</p>
                </div>

                <div class="bg-white rounded-xl shadow-md p-6 text-center">
                    <div class="w-12 h-12 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <h3 class="font-bold text-text mb-2">گزارش‌گیری</h3>
                    <p class="text-sm text-text-muted">گزارش‌های روزانه، هفتگی و ماهانه</p>
                </div>

                <div class="bg-white rounded-xl shadow-md p-6 text-center">
                    <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h3 class="font-bold text-text mb-2">مدیریت مرخصی</h3>
                    <p class="text-sm text-text-muted">ثبت و پیگیری درخواست‌های مرخصی</p>
                </div>
            </div>
        </section>

        <!-- Back Link -->
        <section class="text-center pb-8">
            <a href="/" class="text-primary hover:opacity-80 transition">
                بازگشت به صفحه اصلی
            </a>
        </section>
    </div>

    <script>
        document.getElementById('attendanceForm')?.addEventListener('submit', function(e) {
            e.preventDefault();

            const messageDiv = document.getElementById('loginMessage');
            if (messageDiv) {
                messageDiv.innerHTML = `
                    <div class="bg-blue-50 border border-blue-200 text-blue-800 p-4 rounded-lg">
                        <div class="flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span>در حال بررسی اطلاعات...</span>
                        </div>
                    </div>
                `;
                messageDiv.classList.remove('hidden');

                // Simulate login check
                setTimeout(() => {
                    messageDiv.innerHTML = `
                        <div class="success-message">
                            <div class="flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>ورود موفقیت‌آمیز! در حال انتقال به داشبورد...</span>
                            </div>
                        </div>
                    `;
                }, 1500);
            }
        });
    </script>
</Layout>
