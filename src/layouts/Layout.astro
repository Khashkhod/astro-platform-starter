---
import '../../src/styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
    <head>
        <meta charset="UTF-8" />
        <title>{title} | گنجاب ساز همدان</title>
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content="پورتال اداری شرکت گنجاب ساز همدان - مدیریت تنخواه و حضور و غیاب" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    </head>
    <body class="antialiased min-h-screen">
        <div class="flex flex-col min-h-screen">
            <Header />
            <main class="grow py-8">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>
